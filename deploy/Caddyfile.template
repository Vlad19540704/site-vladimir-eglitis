# Replace SITE_DOMAIN only after the domain is owned and points to this new VPS.
SITE_DOMAIN {
    root * /srv/site/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=15552000"
        -Server
    }
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @html not path /assets/*
    header @html Cache-Control "no-cache"
    @hidden path /.git/* /.env* /deploy/* /scripts/* /Caddyfile*
    respond @hidden 404
    @manifest path /release-manifest.json
    respond @manifest 404
    @index path /index.html
    redir @index / 308
    file_server
    handle_errors 404 {
        rewrite * /404.html
        file_server
    }
    # No per-request access log until the data policy and retention are approved.
}

www.SITE_DOMAIN {
    redir https://SITE_DOMAIN{uri} 308
}

http://127.0.0.1:8081 {
    root * /srv/site/staging/current
    header X-Robots-Tag "noindex, nofollow"
    @hidden path /.git/* /.env* /deploy/* /scripts/* /release-manifest.json
    respond @hidden 404
    file_server
}
