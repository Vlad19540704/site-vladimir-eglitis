# Replace SITE_DOMAIN only after the domain is owned and points to this new VPS.
SITE_DOMAIN {
    root * /srv/site/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }
    @hidden path /.git/* /.env* /deploy/* /scripts/*
    respond @hidden 404
    file_server
    # No per-request access log until the data policy and retention are approved.
}
